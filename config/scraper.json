{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutSec": 10,
  "pageDelaySec": 1.0,
  "retry": {
    "maxAttempts": 5,
    "baseDelaySec": 2.0,
    "maxDelaySec": 60.0,
    "retryStatus": [429, 500, 502, 503, 504]
  },
  "rendering": {"mode": "static", "waitSelector": "", "timeoutMs": 30000},
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": ["București"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://www.ejobs.ro/company/sportisimo/",
  "sources": {
    "sitemap": "",
    "listing": "https://www.ejobs.ro/locuri-de-munca/sportisimo",
    "jobArchive": "https://www.ejobs.ro/company/sportisimo/"
  },
  "selectors": {
    "jobArticle": ["", "[class*='job']", ".vacancy, .position, .listing-item"],
    "jobTitle": ["", "h1, h2, h3, h4", "[itemprop='title'], [aria-label]", "a"],
    "jobMeta": ["", "p, .meta, [class*='deadline']"]
  }
}
